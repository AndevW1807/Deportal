# Copy this file to .env and fill the credentials there.
# .env is gitignored. Do not put real passwords in this example.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=deportal
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# JWT_SECRET must be at least 32 bytes. Generate it locally. Do not commit the real value.
JWT_SECRET=
